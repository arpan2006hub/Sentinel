# =============================================================================
# Sentinel — Environment Variables (Example / Template)
# =============================================================================
# Copy this file to .env and fill in real values before running Sentinel.
# NEVER commit .env to Git.
# NEVER put real credentials in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Sentinel
APP_DEBUG=true

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Secret key used for signing tokens (generate a strong random value)
SECRET_KEY=

# CORS — allowed origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173

# URL the frontend uses to reach the backend API (all routes live under /api)
VITE_API_BASE_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# PostgreSQL (PLANNED — the current build uses SQLite at $STORAGE_PATH/sentinel.db)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=

# Full connection string (constructed from the values above, or set directly)
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis (PLANNED — analysis runs currently use in-process background tasks)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery broker URL (constructed from Redis settings)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Evidence Storage
# -----------------------------------------------------------------------------
# Local filesystem path where uploaded evidence files will be stored.
# This directory should be OUTSIDE the Git repository.
STORAGE_PATH=./local-evidence-store

# Maximum upload size (in megabytes)
MAX_UPLOAD_SIZE_MB=500

# Model outputs, per-case correlation results, TimeSformer weights
ARTIFACTS_DIR=./artifacts

# -----------------------------------------------------------------------------
# AI models (all optional — sensible defaults are used when unset)
# -----------------------------------------------------------------------------
# TimeSformer weights file; defaults to $ARTIFACTS_DIR/models/timesformer/model.pth
TIMESFORMER_MODEL_PATH=
# Download the TimeSformer weights (~485 MB) automatically on first video analysis
VIDEO_AUTO_DOWNLOAD=false
# Max seconds analysed per video (CPU: ~7 s of compute per video second)
VIDEO_MAX_SECONDS=120
# Baseline scorers; default to $ARTIFACTS_DIR/{cyber,documents,video}/model.joblib when present.
# Set CYBER_MODEL_PATH to the CERT Random Forest bundle to score real CERT features.
CYBER_MODEL_PATH=
DOCUMENT_MODEL_PATH=
VIDEO_FEATURES_MODEL_PATH=

# -----------------------------------------------------------------------------
# MLflow (PLANNED)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sentinel-default

# -----------------------------------------------------------------------------
# Security (future)
# -----------------------------------------------------------------------------
# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Whether to require authentication (set false only for local dev)
AUTH_ENABLED=false
